{
  "name": "undangan-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@undangan/web",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "test:e2e": "playwright test",
    "assets:validate": "node scripts/blocked.mjs assets:validate T-504 \"asset pipeline not implemented\"",
    "db:migrate": "node scripts/blocked.mjs db:migrate T-101 \"Supabase CLI/Docker unavailable\"",
    "db:seed": "node scripts/blocked.mjs db:seed T-101 \"Supabase CLI/Docker unavailable\""
  },
  "prettier": "@undangan/config/prettier.json",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@undangan/config": "workspace:*",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
